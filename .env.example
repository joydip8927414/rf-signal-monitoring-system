# RF Monitor - Environment Configuration Example
# Copy this file to .env and replace the values with your actual configuration.
# DO NOT COMMIT YOUR REAL .env FILE.

# ---------------------------------------------------------
# Flask Backend Configuration
# ---------------------------------------------------------
FLASK_ENV=development
# Replace with a cryptographically secure string in production
SECRET_KEY=rf-monitor-dev-secret
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# ---------------------------------------------------------
# Database Configuration
# ---------------------------------------------------------
# Leave blank for local SQLite development
# For Render PostgreSQL: postgres://username:password@hostname/dbname
DATABASE_URL=

# ---------------------------------------------------------
# Security & CORS
# ---------------------------------------------------------
# Allowed origins for the frontend (e.g., https://your-app.vercel.app)
CORS_ORIGINS=*

# Device Authentication Token
# Required for ESP32 to push measurements. Must match the token in ESP32 firmware.
DEVICE_TOKEN=your-secure-device-token

# ---------------------------------------------------------
# Application Behavior
# ---------------------------------------------------------
# Hardware Source: 'simulator' or 'esp32'
RF_SOURCE=simulator

# ESP32 specific configuration (if using pull-based polling instead of push)
ESP32_HOST=192.168.1.100
ESP32_PORT=80
